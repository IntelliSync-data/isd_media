<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_isd_media_root"
              name="ISD Media"
              web_icon="isd_media,static/description/icon.png"
              sequence="100"/>

    <!-- Upload Media -->
    <menuitem id="menu_isd_media_upload"
              name="Upload Media"
              parent="menu_isd_media_root"
              action="action_isd_media"
              groups="group_media_user"
              sequence="10"/>

    <!-- Categories -->
    <menuitem id="menu_isd_media_category"
              name="Categories"
              parent="menu_isd_media_root"
              action="action_isd_media_category"
              groups="group_media_user"
              sequence="20"/>

    <!-- Tags -->
    <menuitem id="menu_isd_media_tag"
              name="Tags"
              parent="menu_isd_media_root"
              action="action_isd_media_tag"
              groups="group_media_user"
              sequence="30"/>

    <!-- Configuration (Admin only) -->
    <menuitem id="menu_isd_media_config"
              name="Configuration"
              parent="menu_isd_media_root"
              action="action_isd_media_configuration"
              groups="group_media_admin"
              sequence="90"/>
</odoo>
